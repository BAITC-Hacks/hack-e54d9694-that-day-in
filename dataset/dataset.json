    "city_formula": "sum(population_share * district_score)",
    "score_formula": "0.7 * city_average + 0.3 * minimum_district_score - 1.0 * critical_count",
    "city_average_weight": 0.7,
    "minimum_district_weight": 0.3,
    "critical_threshold": 40,
    "critical_comparison": "strictly_less_than",
    "critical_penalty_per_pair": 1,
    "clip_after_all_effects": true
  },
